{
  "name": "desktop-panel",
  "version": "0.1.2",
  "description": "快捷键唤醒、可钉住置顶的桌面速记面板",
  "main": "./out/main/index.js",
  "author": "desktop-panel",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist": "electron-vite build && electron-builder --win --publish never"
  },
  "build": {
    "appId": "com.desktoppanel.notes",
    "productName": "Desktop Panel",
    "artifactName": "DesktopPanel-${version}-${arch}.${ext}",
    "publish": {
      "provider": "github",
      "owner": "r56661828-cloud",
      "repo": "desktop-panel",
      "releaseType": "release"
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**",
      "package.json",
      "!node_modules/**"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "."
      }
    ],
    "win": {
      "icon": "resources/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Desktop Panel",
      "artifactName": "DesktopPanel-Setup-${version}.${ext}"
    }
  },
  "dependencies": {
    "@lucide/vue": "^1.45.0",
    "@tiptap/extension-bubble-menu": "^3.31.3",
    "@tiptap/extension-highlight": "^3.31.3",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/extension-link": "^3.31.3",
    "@tiptap/extension-table": "^3.31.3",
    "@tiptap/extension-table-cell": "^3.31.3",
    "@tiptap/extension-table-header": "^3.31.3",
    "@tiptap/extension-table-row": "^3.31.3",
    "@tiptap/extension-text-style": "^3.31.3",
    "@tiptap/extension-underline": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@tiptap/vue-3": "^3.31.3",
    "electron-updater": "^6.8.9",
    "naive-ui": "^2.45.3",
    "pinia": "^4.0.3",
    "tiptap-markdown": "^0.9.0",
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/devtools-api": "^8.2.1",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "jsdom": "^30.0.1",
    "playwright-core": "^1.63.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0",
    "vue-tsc": "^3.3.11"
  },
  "license": "MIT",
  "repository": "github:r56661828-cloud/desktop-panel"
}
