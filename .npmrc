# electron 二进制镜像（国内网络 GitHub releases 不可达）
# electron v44+ 无 postinstall：npm install 不下载二进制，首次启动时懒加载下载，
# npm 运行脚本时会把本文件导出为 npm_config_electron_mirror 等环境变量供其读取。
electron_mirror=https://npmmirror.com/mirrors/electron/
# electron-builder 打包时下载 NSIS/winCodeSign 等工具同样走 GitHub，需要镜像
electron_builder_binaries_mirror=https://npmmirror.com/mirrors/electron-builder-binaries/
